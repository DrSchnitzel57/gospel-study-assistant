# Database
DATABASE_URL=postgresql://gospel:gospelpass@db:5432/gospel_db

# ── LLM Endpoint (chat completions for search) ─────────────────────────────
# Base URL for your LLM server (must support OpenAI-compatible /v1/chat/completions)
# NOTE: the app runs inside Docker, where "localhost" refers to the container
# itself. If your model server runs on the docker host, use the host machine's
# LAN IP (e.g. http://192.168.1.50:8080/v1) or http://host.docker.internal:8080/v1.
LLM_BASE_URL=
# API key for your LLM endpoint (leave empty if not required)
LLM_API_KEY=
# Model name as registered on your LLM endpoint
LLM_MODEL=
# Enable/disable model reasoning (thinking) for search LLM calls.
# Default "true" (reasoning improves extraction quality). Set to "false" for
# faster, stricter JSON-only output.
LLM_ENABLE_THINKING=true
# Maximum output tokens per completion. Reasoning models need headroom to finish
# thinking AND emit the JSON; too low truncates the response (default 8192).
LLM_MAX_TOKENS=8192

# ── Embedding Endpoint (vector embeddings for ingestion + search) ──────────
# Base URL for your embedding server (must support OpenAI-compatible /v1/embeddings)
# Same Docker networking note as LLM_BASE_URL above: use a LAN IP or
# http://host.docker.internal to reach the host from inside a container.
EMBEDDING_BASE_URL=
# API key for your embedding endpoint (leave empty if not required)
EMBEDDING_API_KEY=
# Model name as registered on your embedding endpoint
EMBEDDING_MODEL=
# Vector dimensions (must match your embedding model output)
# Common values: 768 (nomic-embed-text), 1024 (text-embedding-3-small), 4096 (Qwen3-Embedding-8B)
EMBEDDING_DIMENSIONS=1024

# ── Legacy fallback (if LLM_BASE_URL/EMBEDDING_BASE_URL are not set) ──────
# OPENAI_BASE_URL=
# OPENAI_API_KEY=

# ── Search Configuration ───────────────────────────────────────────────────
# Minimum cosine similarity for chunks to be considered relevant (0.0-1.0)
# Lower = more results, Higher = stricter matching. Tune for your embedding model.
# Recommended: 0.25-0.35 for 1024-dim models, 0.30-0.40 for 768-dim models
SEARCH_MIN_SIMILARITY=0.15
# Minimum number of relevant chunks before calling the LLM
SEARCH_MIN_CHUNKS=3
# Maximum number of chunks to send to the LLM
SEARCH_MAX_CHUNKS=25
# Maximum chunks per source document in the LLM context (spreads results across sources)
SEARCH_MAX_CHUNKS_PER_DOCUMENT=3
# Maximum quotes returned per search
SEARCH_MAX_QUOTES=20
# Maximum quotes from any single source document (talk, scripture book, lesson, essay)
SEARCH_MAX_QUOTES_PER_SOURCE=3
# Minimum quotes guaranteed per selected category (remaining slots fill by relevance)
SEARCH_MIN_QUOTES_PER_CATEGORY=2
# LLM request timeout in milliseconds (default 120000 = 120 seconds)
LLM_TIMEOUT=120000

# ── Authentication ─────────────────────────────────────────────────────────
# Shared family password (plain text or bcrypt hash)
FAMILY_SHARED_SECRET=
# NextAuth secret (generate with: openssl rand -hex 32)
NEXTAUTH_SECRET=
# Optional — the app derives its URL from the incoming request host header, so
# leave this unset and access the app via the host IP/name of this machine
# (e.g. http://192.168.x.x:3000), not "localhost", from other devices.
NEXTAUTH_URL=http://localhost:3000
